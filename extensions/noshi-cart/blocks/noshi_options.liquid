{% comment %}
  構成要素#1「のし入力ブロック」。カートページの各商品に熨斗を指定させる。

  ■ なぜカートの「行の中」ではなくフッターに置いてあるのか
  Dawn の `sections/main-cart-items.liquid` は schema に `blocks` を持たず、
  app block を受け付けない。テーマを書き換えれば各行に差し込めるが、それは
  本アプリの存在意義(テーマを書き換えずに機能を足す)を壊す。
  そのため `main-cart-footer` に1ブロックだけ置き、行ごとの入力をここに並べる。

  ■ data-line-key / data-quantity を持たせている理由
  更新は `/cart/change.js` で行うが、実測(リスク3)で次の2点が分かっている。
    * `line` の番号は「後から追加した行が先頭」で追加順と一致しない
      → 行の指定は `key` で行う
    * `properties` を送るときに `quantity` を省略すると数量が黙って 1 に落ちる
      → 現在の数量を必ず添えて送る
  JS 側がこの2つを使うため、行ごとに data 属性として持たせている。
{% endcomment %}

{{ 'noshi-cart.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  独立行化(2026-08-14)により、のし代・包装料もカートの通常商品行として cart.items に
  現れる。variant ID は shop metafield `$app:noshi_settings`(access.storefront = public_read)
  から読み、(1) 熨斗入力UIの対象からのし代・包装料自身を除外する、(2) JS 側が fee 行を
  特定して非表示にできるようルート要素に data 属性として渡す、の2箇所で使う。
  metafield が未投入・壊れている場合は空文字のままにし、下の除外・非表示は効かなくなるだけで
  他の熨斗入力自体は動く(Function 側と同じ「設定がなければ何もしない」方針)。
{%- endcomment -%}
{%- comment -%}
  metafield の variant ID は Admin API の GID(`gid://shopify/ProductVariant/12345`)。
  Liquid の `item.variant_id` は裸の数値なので、末尾セグメントだけ取り出して比較する。

  `shop.metafields.app.noshi_settings` および `shop.metafields['$app:noshi_settings']` の
  短縮記法は実機で検証したところ解決できなかった(2026-08-14、theme console で確認)。
  namespace を `app--{app_id}` で直接指定する形に倒す(snippets/noshi-title-options.liquid の
  Metaobject 参照と同じ理由・同じ書き方)。
{%- endcomment -%}
{%- assign noshi_settings = shop.metafields['app--410001276929']['noshi_settings'].value -%}
{%- assign noshi_fee_variant_id = noshi_settings.noshiFeeVariantId | split: '/' | last | default: '' -%}
{%- assign wrap_fee_variant_id = noshi_settings.wrapFeeVariantId | split: '/' | last | default: '' -%}

<div
  class="noshi-cart"
  data-noshi-root
  data-noshi-fee-variant-id="{{ noshi_fee_variant_id }}"
  data-wrap-fee-variant-id="{{ wrap_fee_variant_id }}"
>
  <h2 class="noshi-cart__heading">{{ 'noshi.heading' | t }}</h2>

  {%- if cart.item_count == 0 -%}
    <p class="noshi-cart__empty">{{ 'noshi.cart_empty' | t }}</p>
  {%- else -%}
    <ul class="noshi-cart__list" role="list">
      {%- for item in cart.items -%}
        {%- assign item_variant_id = item.variant_id | append: '' -%}
        {%- if item_variant_id == noshi_fee_variant_id or item_variant_id == wrap_fee_variant_id -%}
          {%- continue -%}
        {%- endif -%}
        {%- assign noshi_title = item.properties['表書き'] -%}
        {%- assign noshi_name = item.properties['名入れ'] -%}
        {%- assign noshi_type = item.properties['のし種別'] -%}
        {%- assign uid = block.id | append: '-' | append: forloop.index -%}

        <li
          class="noshi-cart__item"
          data-noshi-line
          data-line-key="{{ item.key }}"
          data-line-index="{{ forloop.index0 }}"
          data-variant-id="{{ item.variant_id }}"
          data-quantity="{{ item.quantity }}"
          data-message-select-title="{{ 'noshi.error_select_title' | t | escape }}"
          data-message-save-failed="{{ 'noshi.error_save_failed' | t | escape }}"
        >
          <div class="noshi-cart__product">
            <span class="noshi-cart__product-title">{{ item.product.title }}</span>
            {%- unless item.product.has_only_default_variant -%}
              <span class="noshi-cart__product-variant">{{ item.variant.title }}</span>
            {%- endunless -%}
            <span class="noshi-cart__product-qty">{{ 'noshi.quantity' | t: qty: item.quantity }}</span>
          </div>

          <label class="noshi-cart__toggle">
            <input
              type="checkbox"
              data-noshi-enabled
              {% if noshi_title != blank %}checked{% endif %}
            >
            <span>{{ 'noshi.enable' | t }}</span>
          </label>

          <div class="noshi-cart__fields" data-noshi-fields {% if noshi_title == blank %}hidden{% endif %}>
            {%- if item.quantity > 1 -%}
              <p class="noshi-cart__note">{{ 'noshi.same_for_all' | t: qty: item.quantity }}</p>
            {%- endif -%}

            <div class="noshi-cart__field">
              <label for="noshi-title-{{ uid }}">{{ 'noshi.title_label' | t }}</label>
              <select id="noshi-title-{{ uid }}" data-noshi-field="title">
                {% render 'noshi-title-options', selected: noshi_title %}
              </select>
            </div>

            <div class="noshi-cart__field">
              <label for="noshi-name-{{ uid }}">{{ 'noshi.name_label' | t }}</label>
              <input
                id="noshi-name-{{ uid }}"
                type="text"
                data-noshi-field="name"
                value="{{ noshi_name | escape }}"
                maxlength="40"
                placeholder="{{ 'noshi.name_placeholder' | t }}"
              >
            </div>

            {% comment %}
              value は「外のし」「内のし」に固定する。ここに翻訳を入れると、
              ストアの言語を切り替えたときに保存済みの値と一致しなくなり、
              受注側(構成要素#5)が読む印字用データの表記も揺れる。
              翻訳するのは画面に出すラベルだけにとどめる。
            {% endcomment %}
            <fieldset class="noshi-cart__field noshi-cart__field--radio">
              <legend>{{ 'noshi.type_label' | t }}</legend>
              <label class="noshi-cart__radio">
                <input
                  type="radio"
                  name="noshi-type-{{ uid }}"
                  data-noshi-field="type"
                  value="外のし"
                  {% if noshi_type == '内のし' %}{% else %}checked{% endif %}
                >
                <span>{{ 'noshi.type_outer' | t }}</span>
              </label>
              <label class="noshi-cart__radio">
                <input
                  type="radio"
                  name="noshi-type-{{ uid }}"
                  data-noshi-field="type"
                  value="内のし"
                  {% if noshi_type == '内のし' %}checked{% endif %}
                >
                <span>{{ 'noshi.type_inner' | t }}</span>
              </label>
            </fieldset>
          </div>

          {% comment %}
            保存はこのボタンでまとめて1回だけ行う。変更のたびに送らないのは、
            properties を変えた直後はサーバーの描画HTMLが古い値を返し、
            画面を正しくするには実ナビゲーションが要るため(assets/noshi-cart.js の冒頭参照)。
            そのため保存は「押したときに1回、そのあと再読み込み」に寄せている。
          {% endcomment %}
          <div class="noshi-cart__actions">
            <button type="button" class="button noshi-cart__save" data-noshi-save disabled>
              {{ 'noshi.save' | t }}
            </button>
            <p class="noshi-cart__status" data-noshi-status role="status" aria-live="polite"></p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

<script src="{{ 'noshi-cart.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "のし入力",
  "target": "section",
  "settings": []
}
{% endschema %}
