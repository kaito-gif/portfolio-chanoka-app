{% comment %}
  リスク5の検証用ブロック。構成要素#1（のし入力ブロック）の完成形ではない。

  型名 `app--410001276929--noshi_title` は `$app:noshi_title` の実体。
  Liquid では `$app:` の糖衣が使えず、アプリIDを書かないと解決できない
  （`metaobjects['$app:noshi_title']` は Unknown object になる）。

  `.values` の既定の並びは登録順ではないため、`display_order` での明示的な
  ソートが必須。
{% endcomment %}

{% assign noshi_titles = metaobjects['app--410001276929--noshi_title'].values | sort: 'display_order' %}

<div class="noshi-options">
  {% if noshi_titles.size > 0 %}
    <label for="noshi-title">表書き</label>
    <select id="noshi-title" name="properties[表書き]">
      <option value="">熨斗なし</option>
      {% for entry in noshi_titles %}
        <option value="{{ entry.label }}">{{ entry.label }}</option>
      {% endfor %}
    </select>
  {% else %}
    <p>表書きが登録されていません。</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "のし入力(検証用)",
  "target": "section",
  "settings": []
}
{% endschema %}
